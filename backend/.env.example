# --- Serveur ---
PORT=3000

# --- Stockage : "postgres" (défaut) ou "memory" (aucune base, tout est oublié au redémarrage,
#     comme les leçons des post-mortems) ---
STORAGE=postgres
DATABASE_URL="postgresql://gitblame:gitblame@localhost:5432/gitblame?schema=public"

# --- Autres briques (AGENTS.md §2.3 : jamais d'URL en dur) ---
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=5000
# Laisser vide pour désactiver les notifications vers le bot.
BOT_URL=http://localhost:3001

# --- Sécurité (optionnel : vide = désactivé, pratique en local, suicidaire en prod) ---
# Jeton exigé en "Authorization: Bearer" sur l'API (bot -> backend).
API_TOKEN=
# Client secret de l'intégration Sentry (vérifie l'en-tête sentry-hook-signature).
SENTRY_CLIENT_SECRET=
# Secret CI : accepté en "Authorization: Bearer" ou en signature GitHub X-Hub-Signature-256.
CI_WEBHOOK_SECRET=

# --- Règles du jeu ---
# Fatigue ajoutée au bouc émissaire à chaque blâme (0-100).
FATIGUE_PER_BLAME=10
